# root gitignore

# Dependencies
node_modules/

# Next.js
my-app/.next/
my-app/out/

# Production
my-app/build/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS related
.DS_Store
Thumbs.db

# Environment variables
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
